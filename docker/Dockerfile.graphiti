# Graphiti Hermes 定制镜像：DeepSeek LLM + 本地 BGE embedding + 自动启动
FROM zepai/knowledge-graph-mcp:latest

# 1. 安装依赖（sentence-transformers + fastapi + uvicorn）
RUN cd /app/mcp && VIRTUAL_ENV=/app/mcp/.venv uv pip install \
    sentence-transformers fastapi uvicorn 2>&1 | tail -2

# 2. 写入 embedding server
COPY embed_server.py /app/mcp/embed_server.py

# 3. 写入 config.yaml（DeepSeek LLM + 本地 BGE embedding）
COPY config.yaml /app/mcp/config/config.yaml

# 4. patch factories.py（LLM base_url 修复）
COPY factories.py /app/mcp/src/services/factories.py

# 5. entrypoint：先启动 embedding，再启动 MCP
COPY entrypoint.sh /app/mcp/entrypoint.sh
RUN chmod +x /app/mcp/entrypoint.sh

ENTRYPOINT ["/app/mcp/entrypoint.sh"]
